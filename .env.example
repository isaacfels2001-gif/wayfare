# Copy this file to .env and fill in values. See README.md for details.

# Local dev database. Default = SQLite file (zero setup required).
# To use Postgres/MySQL instead, see README "Swapping the database" section.
DATABASE_URL="file:./dev.db"

# Auth.js (NextAuth v5) session signing secret. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Base URL of this app (used for Stripe redirect URLs, absolute links in emails).
APP_URL="http://localhost:3000"

# Stripe TEST MODE keys — https://dashboard.stripe.com/test/apikeys
# Leave blank to run the app with a built-in mock-payment fallback (see README).
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Booking-service adapter selection. "mock" is the only implementation today;
# see src/services/*/index.ts for the swap points (Amadeus/Duffel/Sabre,
# hotel channel manager, DMC feed).
FLIGHT_PROVIDER="mock"
HOTEL_PROVIDER="mock"
TOUR_PROVIDER="mock"

# Transactional email adapter. "mock" logs to console + EmailLog table
# instead of sending real mail. Swap for "resend" or "sendgrid" once an
# adapter + API key exist (see src/services/email/index.ts).
EMAIL_PROVIDER="mock"
EMAIL_FROM="bookings@ota-demo.test"
