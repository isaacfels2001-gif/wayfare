# Copy this file to .env and fill in values. See README.md ("Database" and
# "Deploying to Vercel" sections) for the full walkthrough.

# Postgres connection string. Get this from your database provider
# (Neon is the documented default — see README). On Neon, use the "Pooled
# connection" string so serverless functions don't exhaust the connection
# limit. Must include `?sslmode=require` for most managed providers.
# Example: postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=""

# Auth.js (NextAuth v5) session signing secret. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Base URL of this app (used for Stripe redirect URLs, absolute links in
# emails). Locally: http://localhost:3000. In Vercel: your deployment URL,
# e.g. https://your-project.vercel.app (custom domain if you add one).
# If unset, the app falls back to Vercel's own VERCEL_URL at runtime, then
# to localhost — but setting it explicitly is recommended.
APP_URL="http://localhost:3000"

# Stripe TEST MODE keys — https://dashboard.stripe.com/test/apikeys
# Leave blank to run the app with a built-in mock-payment fallback (see
# README "Payments" section) — useful for quick local testing without a
# Stripe account.
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
# Only needed once you forward webhooks (Stripe CLI locally, or a webhook
# endpoint configured in the Stripe dashboard for a deployed URL).
STRIPE_WEBHOOK_SECRET=""

# Booking-service adapter selection. "mock" is the only implementation today;
# see src/services/*/index.ts for the swap points (Amadeus/Duffel/Sabre,
# hotel channel manager, DMC feed).
FLIGHT_PROVIDER="mock"
HOTEL_PROVIDER="mock"
TOUR_PROVIDER="mock"

# Transactional email adapter. "mock" logs to console + EmailLog table
# instead of sending real mail. Swap for "resend" or "sendgrid" once an
# adapter + API key exist (see src/services/email/index.ts).
EMAIL_PROVIDER="mock"
EMAIL_FROM="bookings@ota-demo.test"
